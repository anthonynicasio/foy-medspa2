---
import '../styles/global.css';
import { Hero } from '@/components/ui/animated-hero';
import {
  BadgeCheck,
  CalendarDays,
  HeartHandshake,
  ShieldCheck,
  Sparkles,
  Star,
  Waves,
} from 'lucide-react';

const services = [
  {
    title: 'Wrinkle Reducers',
    eyebrow: 'Injectables',
    description:
      'Botox and neuromodulator appointments focused on smooth, natural-looking expression.',
    image: '/images/medspa/confident-portrait.jpg',
    imageAlt: 'Editorial portrait with luminous skin',
    imagePosition: 'object-[50%_26%]',
  },
  {
    title: 'Dermal Fillers',
    eyebrow: 'Facial balance',
    description:
      'Thoughtful volume restoration for lips, cheeks, jawline, and facial harmony.',
    image: '/images/medspa/radiant-skin-detail.jpg',
    imageAlt: 'Close-up portrait with radiant skin and soft reflection',
    imagePosition: 'object-[52%_32%]',
  },
  {
    title: 'Skin Lasers',
    eyebrow: 'Tone + texture',
    description:
      'FDA-cleared laser treatments designed to refresh clarity, sun damage, and skin quality.',
    image: '/images/medspa/light-skin-detail.jpg',
    imageAlt: 'Close-up of skin and eye in warm light',
    imagePosition: 'object-[57%_42%]',
  },
  {
    title: 'Tattoo Removal',
    eyebrow: 'PicoWay',
    description:
      'Advanced laser tattoo removal plans with a modern device and provider-led expectations.',
    image: '/images/medspa/soft-reflection-face.jpg',
    imageAlt: 'Serene face reflected through soft warm light',
    imagePosition: 'object-[50%_42%]',
  },
  {
    title: 'Laser Hair Removal',
    eyebrow: 'Smooth skin',
    description:
      'Customized hair reduction programs for lasting confidence across treatment areas.',
    image: '/images/medspa/provider-mask-treatment.jpg',
    imageAlt: 'Provider applying a facial treatment mask',
    imagePosition: 'object-[50%_42%]',
  },
  {
    title: 'Wellness',
    eyebrow: 'Inside out',
    description:
      'Weight loss shots and bioidentical hormones to support how you feel every day.',
    image: '/images/medspa/serum-dropper.jpg',
    imageAlt: 'Golden serum dropper above skin',
    imagePosition: 'object-[52%_48%]',
  },
];

const phoneHref = 'tel:+19042954595';
const bookingUrl = 'https://booking.mangomint.com/737916';

const stats = [
  ['25+', 'Years specializing in medical aesthetics'],
  ['1999', 'Modern medspa care since'],
  ['1:1', 'Customized treatment planning'],
];

const values = [
  'Licensed medical providers and aesthetic specialists',
  'Natural aesthetic philosophy with no overdone results',
  'FDA-cleared technology for laser and skin services',
  'Education-first consults that keep your goals in focus',
];

const testimonials = [
  {
    quote: 'Every experience has been fantastic. I always feel welcome and comfortable, and the team answers product questions without being pushy.',
    name: 'Rebecca Sibley',
    treatment: 'HydraFacial, IPL, laser hair removal, microneedling',
    image: '/images/medspa/confident-portrait.jpg',
    imageAlt: 'Editorial client portrait with glowing skin',
  },
  {
    quote: 'As a first-timer with lip filler, they made me feel completely comfortable throughout the process. I am extremely pleased with the results.',
    name: 'JueJue',
    treatment: 'Lip filler',
    image: '/images/medspa/soft-reflection-face.jpg',
    imageAlt: 'Client portrait in soft warm light',
  },
  {
    quote: 'Fountain of Youth Spa in St. Augustine is absolutely my top spa. It is the only place I go for injections, fillers, facials, and wellness.',
    name: 'Venessa Maxwell',
    treatment: 'Xeomin, fillers, facials, weight loss support',
    image: '/images/medspa/hero-calm-face.jpg',
    imageAlt: 'Relaxed client portrait after treatment',
  },
  {
    quote: 'Every service has been provided with the utmost care. My skin has never looked better. I would not go anywhere else.',
    name: 'Alexandria Kaller',
    treatment: 'Facials, laser hair removal, Botox',
    image: '/images/medspa/radiant-skin-detail.jpg',
    imageAlt: 'Close-up portrait with radiant skin',
  },
  {
    quote: 'Taylor has worked with me to find the root of my acne. I always leave feeling refreshed and like my skin is brand new.',
    name: 'elliott',
    treatment: 'Acne treatments, dermaplaning',
    image: '/images/medspa/light-skin-detail.jpg',
    imageAlt: 'Close-up of luminous skin in warm light',
  },
  {
    quote: 'Shannon customized my facial to meet my skin goals and needs. She was so kind and knowledgeable. My skin has never looked better.',
    name: 'Alyssa Ingham',
    treatment: 'Customized facial',
    image: '/images/medspa/facial-treatment.jpg',
    imageAlt: 'Calm facial treatment in a medspa room',
  },
  {
    quote: 'I have been going to the spa for 10+ years. The team is always professional and knowledgeable, and I have always had a great experience.',
    name: 'Wendy V',
    treatment: 'Laser hair removal, dark spot removal, Botox',
    image: '/images/medspa/provider-mask-treatment.jpg',
    imageAlt: 'Provider-led facial treatment moment',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Fountain of Youth Spa & Laser Center offers modern medical aesthetics, injectables, lasers, tattoo removal, skincare, and wellness services."
    />
    <title>Fountain of Youth Spa & Laser Center</title>
  </head>
  <body class="surface-cream text-espresso antialiased">
    <div class="overflow-hidden pb-24 sm:pb-0">
      <header class="fixed inset-x-0 top-0 z-50 border-b border-white/35 bg-cream/70 backdrop-blur-[20px] backdrop-saturate-[180%]">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
          <a href="#" class="font-display text-2xl tracking-tight">Fountain of Youth</a>
          <div class="hidden items-center gap-8 text-sm uppercase tracking-[0.24em] text-espresso/70 md:flex">
            <a class="transition hover:text-clay" href="#services">Services</a>
            <a class="transition hover:text-clay" href="#approach">Approach</a>
            <a class="transition hover:text-clay" href="#membership">Plans</a>
          </div>
          <a
            href="#book"
            class="rounded-full bg-espresso px-5 py-3 text-xs font-bold uppercase tracking-[0.22em] text-cream shadow-sm transition hover:bg-clay"
          >
            Book now
          </a>
        </nav>
      </header>

      <main>
        <section class="surface-cream grain relative min-h-screen overflow-hidden px-5 pb-24 pt-32 lg:px-8 lg:pb-32 lg:pt-40">
          <div class="pointer-events-none absolute inset-x-0 top-0 -z-10">
            <div class="absolute left-1/2 h-64 w-3/5 -translate-x-1/2 scale-[2.5] rounded-[50%] bg-[radial-gradient(ellipse_at_center,_hsl(var(--brand-foreground)/0.5)_10%,_transparent_60%)] sm:h-[512px]"></div>
            <div class="absolute left-1/2 h-32 w-2/5 -translate-x-1/2 scale-[2] rounded-[50%] bg-[radial-gradient(ellipse_at_center,_hsl(var(--brand)/0.3)_10%,_transparent_60%)] sm:h-64"></div>
          </div>
          <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
            <Hero client:load />

            <div class="relative pb-20 lg:pb-14">
              <div class="aspect-[4/5] overflow-hidden rounded-[2.75rem] surface-sand p-3 shadow-soft">
                <div class="relative h-full overflow-hidden rounded-[2.25rem]">
                  <img
                    src="/images/medspa/hero-calm-face.jpg"
                    alt="Woman with glowing skin resting in warm natural light"
                    class="h-full w-full object-cover object-[48%_34%]"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-espresso/70 via-espresso/10 to-transparent"></div>
                  <div class="absolute bottom-28 left-5 right-5 rounded-[1.75rem] border border-white/25 bg-cream/15 p-5 text-cream shadow-soft backdrop-blur-xl sm:bottom-24 sm:left-6 sm:right-6 sm:p-6">
                    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cream/70">Provider-led care</p>
                    <p class="mt-4 font-display text-3xl leading-none sm:text-4xl">A better you, not a different person.</p>
                  </div>
                </div>
              </div>
              <div class="absolute left-4 top-8 z-20 hidden w-48 overflow-hidden rounded-[1.65rem] border-4 border-cream bg-espresso text-cream shadow-soft sm:block lg:-left-6">
                <video
                  class="aspect-[4/3] w-full object-cover"
                  src="/videos/matrix-pro-treatment.mp4"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster="/images/medspa/facial-treatment.jpg"
                  aria-label="Matrix Pro RF microneedling treatment for skin tightening and glow"
                ></video>
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-espresso/90 via-espresso/45 to-transparent p-4">
                  <p class="text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-blush">Treatment film</p>
                  <p class="mt-1 font-display text-2xl leading-none">Matrix Pro glow</p>
                </div>
              </div>
              <div class="absolute bottom-0 right-0 z-10 grid w-[92%] grid-cols-3 overflow-hidden rounded-[1.75rem] bg-white shadow-soft sm:w-[82%]">
                {stats.map(([number, label]) => (
                  <div class="border-r border-espresso/10 p-5 last:border-r-0">
                    <p class="font-display text-3xl">{number}</p>
                    <p class="mt-2 text-xs leading-5 text-espresso/60">{label}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section id="services" class="surface-espresso grain-light relative overflow-hidden px-5 py-32 text-cream lg:px-8 lg:py-40">
          <div class="mx-auto max-w-7xl">
            <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.38em] text-blush">Our services</p>
                <h2 class="mt-5 max-w-3xl font-display text-5xl font-medium leading-none tracking-[0.015em] sm:text-6xl">
                  Personalized care, without the pressure.
                </h2>
              </div>
              <p class="max-w-md text-lg leading-8 text-cream/65">
                Your goals guide every recommendation, from subtle injectables to skin health and wellness plans.
              </p>
            </div>

            <div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {services.map((service) => (
                <article class="group overflow-hidden rounded-[2rem] border border-cream/10 bg-cream/[0.04] p-3 transition duration-300 hover:-translate-y-2 hover:bg-cream hover:text-espresso">
                  <div class="aspect-[4/3] overflow-hidden rounded-[1.5rem] bg-cream/10">
                    <img
                      src={service.image}
                      alt={service.imageAlt}
                      class={`h-full w-full object-cover transition duration-500 group-hover:scale-105 ${service.imagePosition}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="p-4 pt-6">
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blush group-hover:text-clay">{service.eyebrow}</p>
                    <h3 class="mt-6 font-display text-4xl">{service.title}</h3>
                    <p class="mt-5 leading-7 text-cream/65 group-hover:text-espresso/65">{service.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="approach" class="surface-cream grain relative overflow-hidden px-5 py-32 lg:px-8 lg:py-40">
          <div class="mx-auto grid max-w-7xl gap-16 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="overflow-hidden rounded-[2.5rem] surface-sand shadow-soft">
              <img
                src="/images/medspa/facial-treatment.jpg"
                alt="Aesthetic facial treatment in a calm medspa room"
                class="aspect-[5/4] w-full object-cover object-[50%_42%]"
                loading="lazy"
                decoding="async"
              />
              <div class="p-8 sm:p-10">
                <p class="text-sm font-medium uppercase tracking-[0.34em] text-clay">Who we are</p>
                <h2 class="mt-8 font-display text-5xl leading-[0.96]">Medical aesthetics, refined through experience.</h2>
                <p class="mt-8 text-lg leading-8 text-espresso/70">
                  Our team includes physicians, aesthetic nurse practitioners, registered nurses, and medical aestheticians specializing in aesthetic medicine and skin health.
                </p>
              </div>
            </div>
            <div class="grid gap-6 sm:grid-cols-2 xl:gap-8">
              {values.map((value, index) => (
                <div class="rounded-[2.25rem] border border-espresso/10 bg-white/55 p-8 shadow-sm backdrop-blur sm:p-9">
                  <span class="font-display text-6xl leading-none text-clay">0{index + 1}</span>
                  <p class="mt-14 text-xl font-light leading-9 text-espresso/80">{value}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section id="membership" class="surface-cream-soft grain relative overflow-hidden px-5 py-32 lg:px-8 lg:py-40">
          <div class="mx-auto max-w-7xl">
            <div class="mx-auto max-w-3xl text-center">
              <p class="text-sm font-medium uppercase tracking-[0.38em] text-clay">Confidence, cared for</p>
              <h2 class="mt-7 font-display text-5xl leading-[0.96] sm:text-6xl">
                A guided plan for skin, body, and long-term confidence.
              </h2>
              <p class="mt-8 text-lg font-light leading-8 text-espresso/70">
                Inspired by a membership-minded care model, this concept gives Fountain of Youth a premium path for consultations, treatment plans, and recurring care.
              </p>
            </div>

            <div class="mt-16 grid gap-4 lg:grid-cols-2">
              <article class="surface-cream grain rounded-[2rem] border border-espresso/10 p-4 shadow-soft">
                <div class="rounded-[1.5rem] border border-white/60 bg-white/35 p-4 backdrop-blur-xl">
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <p class="text-sm font-medium uppercase tracking-[0.28em] text-clay">Maintain</p>
                    <h3 class="mt-5 font-display text-5xl leading-none">Glow Plan</h3>
                  </div>
                  <div class="rounded-full bg-clay/10 p-4 text-clay">
                    <Sparkles className="h-6 w-6" />
                  </div>
                </div>
                <p class="mt-7 max-w-xl text-lg font-light leading-8 text-espresso/68">
                  Designed for consistent skin health, member savings, and gentle provider-led maintenance.
                </p>
                <div class="mt-9 grid gap-4 sm:grid-cols-3">
                  <div class="rounded-[1.25rem] border border-espresso/10 bg-white/45 p-4">
                    <CalendarDays className="h-5 w-5 text-clay" />
                    <p class="mt-4 text-sm font-medium leading-6 text-espresso/75">Recurring care cadence</p>
                  </div>
                  <div class="rounded-[1.25rem] border border-espresso/10 bg-white/45 p-4">
                    <BadgeCheck className="h-5 w-5 text-clay" />
                    <p class="mt-4 text-sm font-medium leading-6 text-espresso/75">Member treatment savings</p>
                  </div>
                  <div class="rounded-[1.25rem] border border-espresso/10 bg-white/45 p-4">
                    <HeartHandshake className="h-5 w-5 text-clay" />
                    <p class="mt-4 text-sm font-medium leading-6 text-espresso/75">Provider check-ins</p>
                  </div>
                </div>
                </div>
              </article>

              <article class="surface-espresso grain-light rounded-[2rem] border border-cream/10 p-4 text-cream shadow-soft">
                <div class="rounded-[1.5rem] border border-cream/10 bg-cream/[0.035] p-4 backdrop-blur-xl">
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <p class="text-sm font-medium uppercase tracking-[0.28em] text-blush">Transform</p>
                    <h3 class="mt-5 font-display text-5xl leading-none">Laser Plan</h3>
                  </div>
                  <div class="rounded-full bg-blush/15 p-4 text-blush">
                    <Waves className="h-6 w-6" />
                  </div>
                </div>
                <p class="mt-7 max-w-xl text-lg font-light leading-8 text-cream/70">
                  A structured path for resurfacing, hair removal, or tattoo removal with clear milestones.
                </p>
                <div class="mt-9 grid gap-4 sm:grid-cols-3">
                  <div class="rounded-[1.25rem] border border-cream/10 bg-cream/[0.05] p-4">
                    <ShieldCheck className="h-5 w-5 text-blush" />
                    <p class="mt-4 text-sm font-medium leading-6 text-cream/78">FDA-cleared technology</p>
                  </div>
                  <div class="rounded-[1.25rem] border border-cream/10 bg-cream/[0.05] p-4">
                    <CalendarDays className="h-5 w-5 text-blush" />
                    <p class="mt-4 text-sm font-medium leading-6 text-cream/78">Milestone-based series</p>
                  </div>
                  <div class="rounded-[1.25rem] border border-cream/10 bg-cream/[0.05] p-4">
                    <Sparkles className="h-5 w-5 text-blush" />
                    <p class="mt-4 text-sm font-medium leading-6 text-cream/78">Tone and texture goals</p>
                  </div>
                </div>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section class="surface-espresso grain-light relative overflow-hidden px-5 py-32 text-cream lg:px-8 lg:py-40">
          <div class="mx-auto max-w-7xl">
            <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
              <div class="max-w-3xl">
                <p class="text-sm font-medium uppercase tracking-[0.38em] text-blush">Google reviews</p>
                <h2 class="mt-7 font-display text-5xl font-medium leading-[0.96] tracking-[0.015em] sm:text-6xl">
                  Loved by clients across St. Augustine.
                </h2>
              </div>
              <div class="rounded-[2rem] border border-cream/10 bg-cream/[0.06] p-6 shadow-soft backdrop-blur">
                <div class="flex items-center gap-1 text-[#E6C98F]">
                  {Array.from({ length: 5 }).map(() => <Star className="h-4 w-4 fill-current" />)}
                </div>
                <p class="mt-4 font-display text-4xl leading-none">4.9</p>
                <p class="mt-2 text-sm font-light leading-6 text-cream/62">Based on 221 Google reviews</p>
              </div>
            </div>

            <div class="mt-14 flex snap-x gap-5 overflow-x-auto pb-5 [scrollbar-width:none]">
              {testimonials.map((testimonial) => (
                <article class="min-w-[82%] snap-center overflow-hidden rounded-[2.25rem] border border-cream/10 bg-cream/[0.06] shadow-soft backdrop-blur sm:min-w-[42%] lg:min-w-[31%]">
                  <img
                    src={testimonial.image}
                    alt={testimonial.imageAlt}
                    class="aspect-[4/3] w-full object-cover object-[50%_34%]"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="p-7">
                    <div class="mb-6 flex items-center gap-1 text-[#E6C98F]">
                      {Array.from({ length: 5 }).map(() => <Star className="h-3.5 w-3.5 fill-current" />)}
                    </div>
                    <p class="font-display text-3xl leading-[1.08]">&ldquo;{testimonial.quote}&rdquo;</p>
                    <div class="mt-7 border-t border-cream/10 pt-5">
                      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blush">{testimonial.name}</p>
                      <p class="mt-2 text-sm text-cream/58">{testimonial.treatment}</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="book" class="surface-cream grain relative overflow-hidden px-5 py-32 lg:px-8 lg:py-40">
          <div class="surface-clay grain-light relative mx-auto grid max-w-6xl overflow-hidden rounded-[2.5rem] text-cream shadow-soft lg:grid-cols-[0.9fr_1.1fr]">
            <img
              src="/images/medspa/hero-calm-face.jpg"
              alt="Relaxed skincare portrait in natural light"
              class="h-full min-h-80 w-full object-cover object-[50%_34%] lg:order-2"
              loading="lazy"
              decoding="async"
            />
            <div class="p-8 sm:p-14">
              <p class="text-sm font-semibold uppercase tracking-[0.38em] text-cream/70">Not sure where to start?</p>
              <h2 class="mt-5 font-display text-5xl font-medium leading-none tracking-[0.015em] sm:text-6xl">Meet with an expert provider.</h2>
              <p class="mt-6 max-w-2xl text-lg leading-8 text-cream/75">
                Begin with a consultation, transparent education, and a personalized treatment plan built around your goals.
              </p>
              <a href={phoneHref} class="mt-10 inline-flex rounded-full bg-cream px-8 py-4 text-sm font-semibold uppercase tracking-[0.22em] text-espresso transition hover:bg-espresso hover:text-cream">
                Call to book
              </a>
            </div>
          </div>
        </section>
      </main>

      <div class="fixed inset-x-0 bottom-0 z-50 border-t border-white/45 bg-cream/76 p-3 shadow-[0_-18px_55px_rgba(45,41,38,0.16)] backdrop-blur-[20px] backdrop-saturate-[180%] sm:hidden">
        <div class="grid grid-cols-2 gap-3">
          <a
            href={bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-12 items-center justify-center rounded-full bg-espresso text-xs font-bold uppercase tracking-[0.18em] text-cream shadow-sm"
          >
            Book Now
          </a>
          <a
            href={phoneHref}
            class="inline-flex h-12 items-center justify-center rounded-full border border-clay/35 bg-clay text-xs font-bold uppercase tracking-[0.18em] text-cream shadow-sm"
          >
            Call
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
